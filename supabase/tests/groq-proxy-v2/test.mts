import "./setup.mjs";
const m = await import("./v2.mts");
let pass = 0, failN = 0;
const t = (name: string, cond: boolean) => { cond ? pass++ : failN++; console.log((cond ? "PASS " : "FAIL ") + name); };
const ok = (b: any) => !("error" in m.validate(b));
t("valid minimal", ok({ messages: [{ role: "user", content: "hi" }] }));
t("rejects unknown top-level field", !ok({ messages: [{ role: "user", content: "hi" }], model: "x" }));
t("rejects bad role", !ok({ messages: [{ role: "admin", content: "hi" }] }));
t("rejects unknown tool", !ok({ messages: [{ role: "user", content: "hi" }], tools: [{ type: "function", function: { name: "rm_rf", parameters: {} } }] }));
t("accepts known tool", ok({ messages: [{ role: "user", content: "hi" }], tools: [{ type: "function", function: { name: "begin_ride_planning", parameters: {} } }] }));
t("rejects huge message", !ok({ messages: [{ role: "user", content: "x".repeat(13000) }] }));
t("rejects too many messages", !ok({ messages: Array(61).fill({ role: "user", content: "a" }) }));
t("rejects bad reasoning_effort", !ok({ messages: [{ role: "user", content: "hi" }], reasoning_effort: "max" }));
const v: any = m.validate({ messages: [{ role: "user", content: "hi" }], max_tokens: 99999, temperature: 5 });
t("clamps max_tokens to 1500", v.payload.max_tokens === 1500);
t("clamps temperature to 1", v.payload.temperature === 1);
t("tool msg needs tool_call_id", !ok({ messages: [{ role: "tool", content: "{}" }] }));
t("assistant tool_calls with unknown tool rejected", !ok({ messages: [{ role: "assistant", content: null, tool_calls: [{ id: "a", type: "function", function: { name: "evil", arguments: "{}" } }] }] }));
t("assistant tool_calls known accepted", ok({ messages: [{ role: "assistant", content: null, tool_calls: [{ id: "a", type: "function", function: { name: "list_my_rides", arguments: "{}" } }] }] }));
const h = (o: Record<string,string>) => new Headers(o);
const tpm: any = m.classify429("groq", h({ "retry-after": "7" }), JSON.stringify({ error: { message: "Rate limit reached for model `openai/gpt-oss-120b` ... on tokens per minute (TPM): Limit 8000, Used 7000, Requested 2000. Please try again in 7.5s." } }));
t("TPM scope + retry-after header", tpm.scope === "tpm" && tpm.retryAfter === 7 && tpm.temporary);
const rpd: any = m.classify429("groq", h({}), JSON.stringify({ error: { message: "Rate limit reached ... on requests per day (RPD): Limit 1000, Used 1000. Please try again in 2m30s." } }));
t("RPD scope + parsed 2m30s", rpd.scope === "rpd" && rpd.retryAfter === 150);
const tpd: any = m.classify429("groq", h({}), JSON.stringify({ error: { message: "on tokens per day (TPD): Limit 200000" } }));
t("TPD scope default long wait", tpd.scope === "tpd" && tpd.retryAfter === 3600);
const hdr: any = m.classify429("groq", h({ "x-ratelimit-remaining-tokens": "0" }), "{}");
t("header-only TPM detection", hdr.scope === "tpm" && hdr.retryAfter === 20);
const u = m.usageOf({ usage: { prompt_tokens: 1200, completion_tokens: 300, completion_tokens_details: { reasoning_tokens: 120 } }, choices: [{ message: { tool_calls: [{}, {}] } }] });
t("usage parsed", u.input === 1200 && u.output === 300 && u.reasoning === 120 && u.toolCalls === 2);
const r1 = await m.providerFailure({ kind: "error", code: "rate_limited", status: 429, scope: "rpd", retryAfter: 100, provider: "groq" }).json();
t("provider daily → provider_daily_limit", r1.error.code === "provider_daily_limit");
const r2 = await m.usageRefusal("duplicate_inflight", 3).json();
t("duplicate → request_in_progress", r2.error.code === "request_in_progress");
console.log(`\n${pass} passed, ${failN} failed`);
